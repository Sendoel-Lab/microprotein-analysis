# Copy to config.env, edit the paths, then `source config.env` before running any script.
export MP_DATA=/path/to/sequencing_data        # FASTQ, alignments, count matrices, QC
export MP_RESULTS=/path/to/results             # analysis outputs
export MP_REFS=/path/to/references             # genome index, GTF, rRNA index, riboWaltz annotation
export MP_EXTERNAL=/path/to/external_inputs    # inputs produced outside this repository
export MP_THREADS=16
